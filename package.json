{
  "name": "dsh-appearance",
  "version": "0.1.0",
  "description": "DeepSeek Harness 外观自定义：颜色、字体、壁纸、圆角、透明度、动画（设置 → 外观）",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "appearance",
    "theme",
    "skin"
  ],
  "license": "MIT"
}
